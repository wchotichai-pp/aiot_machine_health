# คัดลอกเป็น .env แล้วแก้ค่า (.env ถูก .gitignore ไว้ ห้ามขึ้น GitHub)

# ---------- Telegram ----------
# token จาก @BotFather (เว้นว่างได้ถ้ายังไม่ใช้ Telegram)
TELEGRAM_TOKEN=
# URL แบบ https ของพอร์ต 8000 เช่น https://abcd1234-8000.asse.devtunnels.ms
MINIAPP_URL=
# user id ที่อนุญาต คั่นด้วยจุลภาค (ดูเลขได้จากข้อความของบอทเมื่อยังไม่มีสิทธิ์)
ALLOWED_USER_IDS=

# ---------- รหัสลับระหว่างบอทกับ gateway (ตั้งเป็นข้อความยาว ๆ แบบสุ่ม) ----------
API_KEY=change-me-to-a-long-random-string

# ---------- AI ----------
# ollama = ใช้ Gemma บน PC (ถ้าล้มเหลวจะใช้กฎแทน) / rules = ใช้กฎคำสำคัญอย่างเดียว
TRANSLATOR=ollama
OLLAMA_MODEL=gemma3:1b
AI_TIMEOUT_S=15

# ---------- กฎตัดสินสถานะ (ค่าสำหรับการเรียนการสอน ไม่ใช่มาตรฐานอุตสาหกรรม) ----------
# เกณฑ์ก่อนเรียนรู้ค่าปกติ (m/s²)
DEFAULT_WARN_RMS=1.0
DEFAULT_ALARM_RMS=2.5
# เกณฑ์ต่ำสุด กันสัญญาณรบกวนของเซ็นเซอร์
MIN_WARN_RMS=0.15
# อุณหภูมิ (°C)
TEMP_WARN=45
TEMP_ALARM=55
# จำนวนค่าที่ใช้เรียนรู้ค่าปกติ (1 ค่า/วินาที)
LEARN_SAMPLES=30
# เกินเกณฑ์ติดกันกี่ครั้งจึงเพิ่มสถานะ / ปกติติดกันกี่ครั้งจึงลดสถานะ
ESCALATE_AFTER=3
RECOVER_AFTER=5
# ไม่มีข้อมูลเกินกี่วินาทีถือว่าออฟไลน์
OFFLINE_AFTER_S=15
# ต้องยืนยันตัวตนแม้แค่อ่านข้อมูล (true แนะนำเมื่อเปิด tunnel)
PROTECT_READS=true
